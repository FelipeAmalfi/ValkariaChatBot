{
  "name": "@valkaria/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist",
    "ingest": "tsx --env-file=../../.env src/infrastructure/ingestion/runIngestion.ts",
    "graph:dev": "tsx --env-file=../../.env src/dev/testGraph.ts",
    "langgraph:serve": "npx @langchain/langgraph-cli dev"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@langchain/community": "^1.1.28",
    "@langchain/core": "^1.1.46",
    "@langchain/langgraph": "^1.3.2",
    "@valkaria/shared": "*",
    "dotenv": "^16.5.0",
    "fastify": "^5.8.5",
    "graphql": "^16.11.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.3",
    "mercurius": "^16.9.0",
    "neo4j-driver": "^5.28.1",
    "next": "^16.2.6",
    "node-fetch": "^3.3.2",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.17",
    "@types/pg": "^8.11.14",
    "@vitest/coverage-v8": "^3.1.4",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
