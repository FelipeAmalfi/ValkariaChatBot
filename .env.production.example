# ============================================================
# ValkariaChatBot — Production Environment Variables
# ============================================================
# Set each block in the corresponding service dashboard.
# NEVER commit real values. Generate secrets with:
#   openssl rand -hex 32

# ─── Render (API) ─────────────────────────────────────────────────────────────

NODE_ENV=production
API_HOST=0.0.0.0
LOG_LEVEL=info

# Supabase — use Transaction mode pooler (port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_POOL_SIZE=5

# Neo4j Aura Free
NEO4J_URI=neo4j+s://[instance-id].databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<aura-generated-password>

# Upstash Redis — TLS URL (rediss://)
REDIS_URL=rediss://default:[password]@[instance].upstash.io:6379

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AI models (free tier defaults)
AI_DEFAULT_MODEL=mistralai/mistral-7b-instruct:free
AI_CHAT_MODEL=mistralai/mistral-7b-instruct:free
AI_FALLBACK_MODEL=google/gemma-3-1b-it:free
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536

# Security
JWT_SECRET=<openssl rand -hex 32>
JWT_EXPIRES_IN=24h
DM_PASSWORD=<min-8-char-random-password>
SEMANTIC_AUTH_THRESHOLD=0.6

# CORS — must match your Vercel project URL exactly
FRONTEND_URL=https://<your-project>.vercel.app

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Vercel (Web) ─────────────────────────────────────────────────────────────
# Add these in Vercel → Project → Settings → Environment Variables

NEXT_PUBLIC_API_URL=https://<your-render-service>.onrender.com
NEXT_PUBLIC_GRAPHQL_URL=https://<your-render-service>.onrender.com/graphql
