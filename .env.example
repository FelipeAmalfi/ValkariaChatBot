# ============================================================
# ValkariaChatBot — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file.

# ------------------------------------------------------------
# App
# ------------------------------------------------------------
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
LOG_LEVEL=info

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
DATABASE_URL=postgresql://valkaria:valkaria@localhost:5432/valkaria_db
DATABASE_POOL_SIZE=10

# ------------------------------------------------------------
# Neo4j
# ------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=valkaria123

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------
# OpenRouter (https://openrouter.ai)
# ------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------
# AI Models (use free models from OpenRouter)
# ------------------------------------------------------------
AI_DEFAULT_MODEL=mistralai/mistral-7b-instruct:free
AI_CHAT_MODEL=mistralai/mistral-7b-instruct:free
AI_FALLBACK_MODEL=google/gemma-3-1b-it:free
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536

# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
JWT_SECRET=change_me_in_production_use_32_chars_min
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ------------------------------------------------------------
# Auth narrativa
# ------------------------------------------------------------
DM_PASSWORD=change_me_dm_password_min8chars
SEMANTIC_AUTH_THRESHOLD=0.6

# ------------------------------------------------------------
# Frontend (Next.js) — prefix with NEXT_PUBLIC_ for client
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:3001/graphql
